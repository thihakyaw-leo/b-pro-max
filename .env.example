# Copy this file to `.env` and fill in your local values.
# `.env` is gitignored — never commit real credentials.
# The app starts without `.env`; these values only override appsettings.json.

# PostgreSQL connection string (overrides Database:ConnectionString)
DATABASE_URL=Host=localhost;Port=5432;Database=bpro_max;Username=postgres;Password=;SSL Mode=Disable;Trust Server Certificate=true

# Alternative form of the same override
# DATABASE_CONNECTION_STRING=
