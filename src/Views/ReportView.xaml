<Page
    x:Class="BProMax.Views.ReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="ReportView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12" Spacing="8">
            <TextBlock Text="Reports" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="ReportTitle"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Report Type:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ReportTypeLabel"/>
                <ComboBox x:Name="ReportTypeCombo" Width="220"
                          AutomationProperties.AutomationId="ReportTypeCombo">
                    <ComboBoxItem Content="Agents" IsSelected="True"
                                  AutomationProperties.AutomationId="ReportTypeAgents"/>
                    <ComboBoxItem Content="Sales"
                                  AutomationProperties.AutomationId="ReportTypeSales"/>
                    <ComboBoxItem Content="2D Sales by Draw"
                                  AutomationProperties.AutomationId="ReportTypeTwoDSalesByDraw"/>
                    <ComboBoxItem Content="2D Sales by Number"
                                  AutomationProperties.AutomationId="ReportTypeTwoDSalesByNumber"/>
                    <ComboBoxItem Content="2D Group Performance"
                                  AutomationProperties.AutomationId="ReportTypeTwoDGroupPerformance"/>
                    <ComboBoxItem Content="2D Payout Register"
                                  AutomationProperties.AutomationId="ReportTypeTwoDPayoutRegister"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Start Date:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ReportStartDateLabel"/>
                <CalendarDatePicker x:Name="StartDatePicker" Width="150"
                                    AutomationProperties.AutomationId="ReportStartDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="End Date:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ReportEndDateLabel"/>
                <CalendarDatePicker x:Name="EndDatePicker" Width="150"
                                    AutomationProperties.AutomationId="ReportEndDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Format:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ReportFormatLabel"/>
                <ComboBox x:Name="ExportFormatCombo" Width="150"
                          AutomationProperties.AutomationId="ReportFormatCombo">
                    <ComboBoxItem Content="PDF" IsSelected="True"
                                  AutomationProperties.AutomationId="FormatPdf"/>
                    <ComboBoxItem Content="Excel"
                                  AutomationProperties.AutomationId="FormatExcel"/>
                    <ComboBoxItem Content="CSV"
                                  AutomationProperties.AutomationId="FormatCsv"/>
                </ComboBox>
                <Button x:Name="GenerateButton" Content="Generate" Click="GenerateButton_Click"
                        AutomationProperties.AutomationId="ReportGenerateButton"/>
                <Button x:Name="ExportButton" Content="Export to File" Click="ExportButton_Click"
                        AutomationProperties.AutomationId="ReportExportButton"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Report output will appear here."
                   Margin="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="ReportOutput"/>
        <TextBlock x:Name="StatusMessage" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="12" Foreground="{ThemeResource SystemControlSuccessTextForegroundBrush}" AutomationProperties.AutomationId="ReportStatus"/>
    </Grid>
</Page>
