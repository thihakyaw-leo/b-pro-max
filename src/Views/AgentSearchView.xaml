<Page
    x:Class="BProMax.Views.AgentSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:BProMax.Models"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="AgentSearchView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12" Spacing="8">
            <TextBlock Text="Search Agents" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="AgentSearchTitle"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Search term:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AgentSearchTermLabel"/>
                <TextBox x:Name="SearchBox" Width="300"
                         AutomationProperties.AutomationId="AgentSearchTermBox"/>
                <Button x:Name="SearchButton" Content="Search" Click="SearchButton_Click"
                        AutomationProperties.AutomationId="AgentSearchButton"/>
            </StackPanel>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="SearchResults" Margin="12"
                  AutomationProperties.AutomationId="AgentSearchResults">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Agent">
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4">
                        <TextBlock Text="{x:Bind Id}" Width="40" AutomationProperties.AutomationId="SearchAgentId"/>
                        <TextBlock Text="{x:Bind AgentName}" Width="200" AutomationProperties.AutomationId="SearchAgentName"/>
                        <TextBlock Text="{x:Bind Address}" Width="250" AutomationProperties.AutomationId="SearchAgentAddress"/>
                        <TextBlock Text="{x:Bind Phone}" Width="120" AutomationProperties.AutomationId="SearchAgentPhone"/>
                        <TextBlock Text="{x:Bind Commission}" Width="100" AutomationProperties.AutomationId="SearchAgentCommission"/>
                        <TextBlock Text="{x:Bind Rate}" Width="80" AutomationProperties.AutomationId="SearchAgentRate"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusMessage" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="12" Foreground="Green" AutomationProperties.AutomationId="AgentSearchStatus"/>
    </Grid>
</Page>
