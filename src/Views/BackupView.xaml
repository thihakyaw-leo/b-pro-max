<Page
    x:Class="BProMax.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="BackupView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12" Spacing="8">
            <TextBlock Text="Database Backup / Restore" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="BackupTitle"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Backup Path:" Width="120" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="BackupPathLabel"/>
                <TextBox x:Name="BackupPathBox" Width="400"
                         AutomationProperties.AutomationId="BackupPathBox"/>
                <Button x:Name="BrowseButton" Content="Browse" Click="BrowseButton_Click"
                        AutomationProperties.AutomationId="BackupBrowseButton"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackupButton" Content="Backup Database" Click="BackupButton_Click"
                        AutomationProperties.AutomationId="BackupButton"/>
                <Button x:Name="RestoreButton" Content="Restore Database" Click="RestoreButton_Click"
                        AutomationProperties.AutomationId="BackupRestoreButton"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusMessage" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="12" Foreground="{ThemeResource SystemControlSuccessTextForegroundBrush}" AutomationProperties.AutomationId="BackupStatus"/>
    </Grid>
</Page>
