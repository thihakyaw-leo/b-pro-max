<Page
    x:Class="BProMax.Views.AutoBuyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BProMax.Models"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="AutoBuyView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12" Spacing="8">
            <TextBlock Text="Auto Buy Rules" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="AutoBuyTitle"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Agent Name:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AutoBuyAgentLabel"/>
                <TextBox x:Name="AgentNameBox" Width="250"
                         AutomationProperties.AutomationId="AutoBuyAgentBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Trigger Amount:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AutoBuyTriggerLabel"/>
                <TextBox x:Name="TriggerAmountBox" Width="150" Text="0"
                         AutomationProperties.AutomationId="AutoBuyTriggerBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Auto Buy Amount:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AutoBuyAmountLabel"/>
                <TextBox x:Name="AutoBuyAmountBox" Width="150" Text="0"
                         AutomationProperties.AutomationId="AutoBuyAmountBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="EnabledCheck" Content="Enabled"
                          AutomationProperties.AutomationId="AutoBuyEnabledCheck"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CreateButton" Content="Create Rule" Click="CreateButton_Click"
                        AutomationProperties.AutomationId="AutoBuyCreateButton"/>
                <Button x:Name="UpdateButton" Content="Update Rule" Click="UpdateButton_Click"
                        AutomationProperties.AutomationId="AutoBuyUpdateButton"/>
                <Button x:Name="DeleteButton" Content="Delete Rule" Click="DeleteButton_Click"
                        AutomationProperties.AutomationId="AutoBuyDeleteButton"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"
                        AutomationProperties.AutomationId="AutoBuyRefreshButton"/>
            </StackPanel>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="RulesList" Margin="12"
                  AutomationProperties.AutomationId="AutoBuyRulesList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AutoBuyRule">
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4">
                        <TextBlock Text="{x:Bind Id}" Width="40" AutomationProperties.AutomationId="RuleId"/>
                        <TextBlock Text="{x:Bind AgentName}" Width="200" AutomationProperties.AutomationId="RuleAgentName"/>
                        <TextBlock Text="{x:Bind TriggerAmount}" Width="120" AutomationProperties.AutomationId="RuleTriggerAmount"/>
                        <TextBlock Text="{x:Bind AutoBuyAmount}" Width="120" AutomationProperties.AutomationId="RuleAutoBuyAmount"/>
                        <TextBlock Text="{x:Bind IsEnabled}" Width="80" AutomationProperties.AutomationId="RuleIsEnabled"/>
                        <TextBlock Text="{x:Bind ExecutionCount}" Width="100" AutomationProperties.AutomationId="RuleExecutionCount"/>
                        <Button Content="Toggle" Click="ToggleButton_Click" Tag="{x:Bind Id}"
                                AutomationProperties.AutomationId="RuleToggleButton"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusMessage" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="12" Foreground="Green" AutomationProperties.AutomationId="AutoBuyStatus"/>
    </Grid>
</Page>
