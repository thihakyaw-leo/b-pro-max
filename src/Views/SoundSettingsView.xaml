<Page
    x:Class="BProMax.Views.SoundSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="SoundSettingsView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12" Spacing="8">
            <TextBlock Text="Sound Settings" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="SoundSettingsTitle"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="EnabledCheck" Content="Sound Enabled"
                          AutomationProperties.AutomationId="SoundEnabledCheck"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Volume:" Width="100" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="SoundVolumeLabel"/>
                <Slider x:Name="VolumeSlider" Width="200" Minimum="0" Maximum="1" StepFrequency="0.1" Value="0.5"
                        AutomationProperties.AutomationId="SoundVolumeSlider"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TestAlertButton" Content="Test Alert Sound" Click="TestAlertButton_Click"
                        AutomationProperties.AutomationId="SoundTestAlertButton"/>
                <Button x:Name="TestNotificationButton" Content="Test Notification Sound" Click="TestNotificationButton_Click"
                        AutomationProperties.AutomationId="SoundTestNotificationButton"/>
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click"
                        AutomationProperties.AutomationId="SoundSaveButton"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusMessage" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="12" Foreground="{ThemeResource SuccessTextBrush}" AutomationProperties.AutomationId="SoundSettingsStatus"/>
    </Grid>
</Page>
