<Window
    x:Class="BProMax.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="b-pro-max - Lottery Agent Management"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="True"
            AutomationProperties.AutomationId="NavView">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavLogin"
                    Content="Login"
                    Icon="Contact"
                    AutomationProperties.AutomationId="NavLogin" />
                <NavigationViewItem
                    x:Name="NavAgents"
                    Content="Agents"
                    Icon="People"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavAgents" />
                <NavigationViewItem
                    x:Name="NavSearch"
                    Content="Search Agents"
                    Icon="Find"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavSearch" />
                <NavigationViewItem
                    x:Name="NavSales"
                    Content="Sales"
                    Icon="Calculator"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavSales" />
                <NavigationViewItem
                    x:Name="NavDraws"
                    Content="Draws &amp; Results"
                    Icon="Calendar"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavDraws" />
                <NavigationViewItem
                    x:Name="NavNumberWisdom"
                    Content="Number Wisdom"
                    Icon="List"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavNumberWisdom" />
                <NavigationViewItem
                    x:Name="NavAutoBuy"
                    Content="Auto Buy"
                    Icon="Shop"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavAutoBuy" />
                <NavigationViewItem
                    x:Name="NavReports"
                    Content="Reports"
                    Icon="Document"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavReports" />
                <NavigationViewItem
                    x:Name="NavMaintenance"
                    Content="Maintenance"
                    Icon="Setting"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavMaintenance" />
                <NavigationViewItem
                    x:Name="NavBackup"
                    Content="Backup"
                    Icon="Save"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavBackup" />
                <NavigationViewItem
                    x:Name="NavCreateDb"
                    Content="Create Database"
                    Icon="Download"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavCreateDb" />
                <NavigationViewItem
                    x:Name="NavCompact"
                    Content="Compact Database"
                    Icon="Repair"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavCompact" />
                <NavigationViewItem
                    x:Name="NavSound"
                    Content="Sound Settings"
                    Icon="Volume"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavSound" />
                <NavigationViewItem
                    x:Name="NavTimeLock"
                    Content="Time Lock"
                    Icon="Clock"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="NavTimeLock" />
                <NavigationViewItem
                    x:Name="NavRegister"
                    Content="Register"
                    Icon="Account"
                    AutomationProperties.AutomationId="NavRegister" />
                <NavigationViewItem
                    x:Name="NavLogout"
                    Content="Logout"
                    Icon="LeaveChat"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="NavLogout" />
            </NavigationView.MenuItems>

            <Frame
                x:Name="ContentFrame"
                AutomationProperties.AutomationId="ContentFrame" />

        </NavigationView>
    </Grid>

</Window>
