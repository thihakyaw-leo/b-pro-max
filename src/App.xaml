<Application
    x:Class="BProMax.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BrandColor" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SurfaceColor" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="ErrorColor" Color="{ThemeResource SystemAccentColorDark1}" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
