<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Phase 1: Trivial hygiene promoted to errors to prevent regression.
         None currently occur in the codebase; pinning them keeps it that way. -->
    <!-- Commented out for Phase 6 implementation: 
    <WarningsAsErrors>CS8019;CS0219;CS0168;CA1805;CA1816;CA1848;CA1305;CA1416;CA1852;CA1862</WarningsAsErrors>
        -->
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Phase 4: CA1707 (identifier naming) is an explicit exception in tests (148 occurrences).
         It is reported as a warning but does not fail the build. -->
    <WarningsNotAsErrors>CA1707</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Guard against nested projects: a child project's generated obj\ and bin\ trees
         must never be picked up by a parent's default **/*.cs glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.322" PrivateAssets="all" />
  </ItemGroup>
</Project>
